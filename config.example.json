{
  "version": 1,
  "storage": {
    "root": "/home/user/.local/share/herdr-delegator/runs"
  },
  "orchestrator": {
    "role": "@plan",
    "thinking": "high"
  },
  "worker_profiles": {
    "default": {
      "role": "@default",
      "thinking": "inherit"
    },
    "task": {
      "role": "@task",
      "thinking": "inherit"
    },
    "slow": {
      "role": "@slow",
      "thinking": "inherit"
    }
  },
  "skill_routing": {
    "rules": [
      { "boundary": "plan", "surface": "orch", "skills": ["inquire"] },
      { "boundary": "authoring", "surface": "orch", "skills": ["readchk", "shower"] },
      { "boundary": "dispatch", "surface": "worker", "skills": ["readchk"] },
      { "boundary": "completion", "surface": "worker", "skills": ["sip"] },
      { "boundary": "settlement", "surface": "orch", "skills": ["gap", "factchk"] },
      { "boundary": "reset", "surface": "orch", "skills": ["re0-memo"] }
    ]
  }
}
