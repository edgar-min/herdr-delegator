{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oh-my-pi.dev/schemas/herdr-delegator-config-v1.json",
  "title": "Herdr Delegator Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "storage"],
  "properties": {
    "version": {
      "const": 1
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root"],
      "properties": {
        "root": {
          "type": "string",
          "pattern": "^/",
          "description": "Absolute deterministic run storage root. At least the user or project layer must configure it; a run layer may not change it."
        }
      }
    },
    "orchestrator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": {
          "$ref": "#/$defs/role"
        },
        "thinking": {
          "$ref": "#/$defs/thinking"
        }
      }
    },
    "worker_profiles": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/profileName"
      },
      "additionalProperties": {
        "$ref": "#/$defs/profilePatch"
      }
    },
    "skill_routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rules"],
      "properties": {
        "rules": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["boundary", "surface", "skills"],
            "properties": {
              "boundary": {
                "enum": ["plan", "authoring", "dispatch", "completion", "settlement", "reset"]
              },
              "surface": {
                "enum": ["orch", "worker"]
              },
              "skills": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
                }
              }
            }
          },
          "description": "Advisory skill routes surfaced in tool results and worker dispatch prompts at matching boundaries. Routes never gate settlement, lifecycle, or authority."
        }
      }
    }
  },
  "$defs": {
    "role": {
      "type": "string",
      "pattern": "^@[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "thinking": {
      "enum": ["inherit", "off", "minimal", "low", "medium", "high", "xhigh", "max", "auto"]
    },
    "profileName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "profilePatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": {
          "$ref": "#/$defs/role"
        },
        "thinking": {
          "$ref": "#/$defs/thinking"
        }
      }
    }
  }
}
