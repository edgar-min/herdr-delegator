{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oh-my-pi.dev/schemas/herdr-delegator-config-v1.json",
  "title": "Herdr Delegator Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "storage"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root"
      ],
      "properties": {
        "root": {
          "type": "string",
          "pattern": "^/",
          "description": "Absolute deterministic run storage root. At least the user or project layer must configure it; a run layer may not change it."
        }
      }
    },
    "orchestrator": {
      "$ref": "#/$defs/orchestratorProfilePatch"
    },
    "worker_profiles": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/profileName"
      },
      "additionalProperties": {
        "$ref": "#/$defs/workerProfilePatch"
      },
      "description": "Worker launch profiles, patched per layer by name. A profile inherits only from the same name in an earlier layer: a name no earlier layer defines must declare `role` in the layer that first defines it, or the layer is rejected with invalid_config. This cross-layer rule is enforced in code, not expressible here."
    },
    "skill_routing": {
      "$ref": "#/$defs/skillRouting"
    }
  },
  "$defs": {
    "role": {
      "type": "string",
      "pattern": "^@[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "thinking": {
      "enum": [
        "inherit",
        "off",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max",
        "auto"
      ]
    },
    "profileName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "skillName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "guidanceText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f]+$"
    },
    "orchestratorProfilePatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": {
          "$ref": "#/$defs/role"
        },
        "thinking": {
          "$ref": "#/$defs/thinking"
        }
      }
    },
    "workerProfilePatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": {
          "$ref": "#/$defs/role"
        },
        "thinking": {
          "$ref": "#/$defs/thinking"
        }
      }
    },
    "skillNames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/skillName"
      }
    },
    "agentRule": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "agent",
            "moment",
            "skills"
          ],
          "properties": {
            "agent": {
              "const": "orch"
            },
            "moment": {
              "enum": [
                "plan",
                "authoring",
                "settlement",
                "reset"
              ]
            },
            "skills": {
              "$ref": "#/$defs/skillNames"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "agent",
            "moment",
            "skills"
          ],
          "properties": {
            "agent": {
              "allOf": [
                {
                  "$ref": "#/$defs/profileName"
                },
                {
                  "not": {
                    "const": "orch"
                  }
                }
              ]
            },
            "moment": {
              "enum": [
                "intake",
                "report"
              ]
            },
            "skills": {
              "$ref": "#/$defs/skillNames"
            }
          }
        }
      ]
    },
    "legacyRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boundary",
        "surface",
        "skills"
      ],
      "properties": {
        "boundary": {
          "enum": [
            "plan",
            "authoring",
            "dispatch",
            "completion",
            "settlement",
            "reset"
          ]
        },
        "surface": {
          "enum": [
            "orch",
            "worker"
          ]
        },
        "skills": {
          "$ref": "#/$defs/skillNames"
        },
        "trigger": {
          "$ref": "#/$defs/guidanceText",
          "description": "Optional advisory prose naming when this legacy route applies."
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/profileName"
          },
          "description": "Optional worker-profile scope. An undefined profile name is valid but never matches; orchestrator delivery points receive only unscoped rules."
        }
      }
    },
    "skillRouting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rules"
      ],
      "properties": {
        "rules": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/agentRule"
              },
              {
                "$ref": "#/$defs/legacyRule"
              }
            ]
          },
          "description": "Advisory routes in agent/moment or legacy boundary/surface form. Routes never gate settlement, lifecycle, or authority."
        }
      }
    }
  }
}
