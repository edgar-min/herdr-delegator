{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oh-my-pi.dev/schemas/herdr-delegator-run-v1.json",
  "title": "Herdr Delegator Run Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "track_id", "run_id", "cwd", "run_path", "created_at", "channels", "skills"],
  "properties": {
    "version": {
      "const": 1
    },
    "track_id": {
      "$ref": "#/$defs/coordinate"
    },
    "run_id": {
      "$ref": "#/$defs/coordinate"
    },
    "cwd": {
      "$ref": "#/$defs/absolutePath"
    },
    "run_path": {
      "$ref": "#/$defs/absolutePath"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "reset_of": {
      "type": "object",
      "additionalProperties": false,
      "required": ["track_id", "run_id", "path"],
      "properties": {
        "track_id": {
          "$ref": "#/$defs/coordinate"
        },
        "run_id": {
          "$ref": "#/$defs/coordinate"
        },
        "path": {
          "$ref": "#/$defs/absolutePath"
        }
      }
    },
    "channels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assignments", "reports", "inter_run"],
      "description": "The run's own document grammar, as path rules relative to the run directory. Written at open so no reader has to infer it from a prompt.",
      "properties": {
        "assignments": {
          "const": "a2a/assignments/<id>.md"
        },
        "reports": {
          "const": "a2a/<lane>-report.md"
        },
        "inter_run": {
          "const": "a2a/orch-to-<track>_<run>.md"
        }
      }
    },
    "skills": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "description": "Birth-time sha256 pins for the four installed role skills — herdr-orch and the default/slow/task worker profile SKILL.md files. A dispatched worker reads the profile skill named in its pointer; there is no common worker skill to read.",
      "required": ["herdr-orch", "herdr-worker-default", "herdr-worker-slow", "herdr-worker-task"],
      "propertyNames": {
        "$ref": "#/$defs/skillName"
      },
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      }
    }
  },
  "$defs": {
    "coordinate": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "absolutePath": {
      "type": "string",
      "pattern": "^/"
    },
    "skillName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
